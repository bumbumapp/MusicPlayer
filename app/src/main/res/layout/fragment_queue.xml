<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".playback.queue.QueueFragment">

    <org.bumbumapps.musicplayer.ui.EdgeCoordinatorLayout
        android:id="@+id/queue_coordinator"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        android:orientation="vertical">

        <org.bumbumapps.musicplayer.ui.EdgeAppBarLayout
            android:id="@+id/queue_appbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorSurface"
            app:liftOnScroll="true"
            app:liftOnScrollTargetViewId="@id/queue_recycler">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/queue_toolbar"
                style="@style/Widget.Auxio.Toolbar.Icon.Down"
                android:elevation="0dp"
                app:navigationIcon="@drawable/ic_down"
                app:title="@string/lbl_queue"
                app:titleTextAppearance="@style/TextAppearance.Auxio.TitleLarge" />

            <!-- The playing song, so the list below reads as "what comes next". -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/queue_now_playing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_medium"
                android:layout_marginEnd="@dimen/spacing_medium"
                android:layout_marginBottom="@dimen/spacing_small"
                android:background="@drawable/ui_now_playing_card"
                android:padding="12dp">

                <androidx.cardview.widget.CardView
                    android:id="@+id/queue_now_cover_card"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    app:cardCornerRadius="@dimen/radius_cover_small"
                    app:cardElevation="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:id="@+id/queue_now_cover"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop" />
                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/queue_now_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:text="@string/lbl_playback"
                    android:textAppearance="@style/TextAppearance.Auxio.Eyebrow"
                    android:textColor="?attr/colorPrimary"
                    app:layout_constraintBottom_toTopOf="@+id/queue_now_title"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/queue_now_cover_card"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_chainStyle="packed" />

                <TextView
                    android:id="@+id/queue_now_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Auxio.TitleMedium"
                    android:textColor="?attr/colorOnSurface"
                    app:layout_constraintBottom_toTopOf="@+id/queue_now_artist"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/queue_now_cover_card"
                    app:layout_constraintTop_toBottomOf="@+id/queue_now_label" />

                <TextView
                    android:id="@+id/queue_now_artist"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Auxio.BodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/queue_now_cover_card"
                    app:layout_constraintTop_toBottomOf="@+id/queue_now_title" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/queue_next_header"
                style="@style/Widget.Auxio.TextView.Header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/spacing_small"
                android:text="@string/lbl_next_up" />

        </org.bumbumapps.musicplayer.ui.EdgeAppBarLayout>

        <org.bumbumapps.musicplayer.ui.EdgeRecyclerView
            android:id="@+id/queue_recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="ifContentScrolls"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior"
            tools:listitem="@layout/item_queue_song" />

    </org.bumbumapps.musicplayer.ui.EdgeCoordinatorLayout>
</layout>