<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".ui.AlbumGridViewHolder">

    <data>

        <variable
            name="album"
            type="org.bumbumapps.musicplayer.music.Album" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/ui_card_ripple"
        android:clickable="true"
        android:focusable="true"
        android:padding="@dimen/spacing_small">

        <androidx.cardview.widget.CardView
            android:id="@+id/album_cover_card"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:layout_constraintDimensionRatio="1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/album_cover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@{@string/desc_album_cover(album.name)}"
                android:scaleType="centerCrop"
                app:albumArt="@{album}"
                tools:src="@drawable/ic_album" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/album_name"
            style="@style/Widget.Auxio.TextView.Base"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingHorizontal="4dp"
            android:text="@{album.name}"
            android:textAppearance="@style/TextAppearance.Auxio.TitleMedium"
            android:textColor="?attr/colorOnSurface"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/album_cover_card"
            tools:text="Album Name" />

        <TextView
            android:id="@+id/album_info"
            style="@style/Widget.Auxio.TextView.Base"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingHorizontal="4dp"
            android:text="@{@string/fmt_two(album.artist.resolvedName, @plurals/fmt_song_count(album.songs.size, album.songs.size))}"
            android:textAppearance="@style/TextAppearance.Auxio.BodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/album_name"
            tools:text="Artist • 10 Songs" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
