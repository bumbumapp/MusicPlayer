<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".home.HomeFragment">

    <org.bumbumapps.musicplayer.ui.EdgeCoordinatorLayout
        android:id="@+id/main_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <org.bumbumapps.musicplayer.ui.EdgeAppBarLayout
            android:id="@+id/home_appbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorSurface"
            app:liftOnScroll="false"
            app:elevation="0dp">

            <!-- Bento header: greeting, big title, square actions and the shuffle hero tile.
                 Scrolls away so the list gets the full screen; tabs stay pinned. -->
            <LinearLayout
                android:id="@+id/home_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="12dp"
                android:paddingEnd="20dp"
                app:layout_scrollFlags="scroll|enterAlways|snap">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/home_greeting"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/jakarta_medium"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="15sp"
                            tools:text="Good evening" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/jakarta_extrabold"
                            android:letterSpacing="-0.03"
                            android:text="@string/lbl_home_title"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="32sp" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/home_search"
                        style="@style/Widget.Auxio.SquareAction"
                        android:contentDescription="@string/lbl_search"
                        android:src="@drawable/ic_search" />

                    <ImageButton
                        android:id="@+id/home_sort"
                        style="@style/Widget.Auxio.SquareAction"
                        android:layout_marginStart="8dp"
                        android:contentDescription="@string/lbl_sort"
                        android:src="@drawable/ic_sort" />

                    <ImageButton
                        android:id="@+id/home_settings"
                        style="@style/Widget.Auxio.SquareAction"
                        android:layout_marginStart="8dp"
                        android:contentDescription="@string/set_title"
                        android:src="@drawable/ic_settings" />
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/home_hero"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="invisible"
                    app:cardBackgroundColor="?attr/colorPrimary"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="20dp">

                        <FrameLayout
                            android:layout_width="64dp"
                            android:layout_height="56dp">

                            <View
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:layout_gravity="end|center_vertical"
                                android:alpha="0.45"
                                android:background="@drawable/bg_hero_disc"
                                android:rotation="10" />

                            <ImageView
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:layout_gravity="start|center_vertical"
                                android:background="@drawable/bg_hero_disc"
                                android:padding="12dp"
                                android:rotation="-6"
                                android:src="@drawable/ic_song"
                                app:tint="?attr/colorPrimary"
                                tools:ignore="ContentDescription" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/jakarta_bold"
                                android:letterSpacing="-0.02"
                                android:text="@string/lbl_shuffle_all"
                                android:textColor="?attr/colorOnPrimary"
                                android:textSize="21sp" />

                            <TextView
                                android:id="@+id/home_hero_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:alpha="0.85"
                                android:fontFamily="@font/jakarta_medium"
                                android:textColor="?attr/colorOnPrimary"
                                android:textSize="14sp"
                                tools:text="42 songs · offline" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_hero_play"
                            android:padding="12dp"
                            android:src="@drawable/ic_shuffle"
                            app:tint="?attr/colorOnPrimary"
                            tools:ignore="ContentDescription" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/home_tabs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_tabs_container"
                android:padding="4dp"
                app:tabGravity="fill"
                app:tabIndicator="@drawable/ui_tab_pill"
                app:tabIndicatorAnimationMode="elastic"
                app:tabIndicatorColor="?attr/colorPrimary"
                app:tabIndicatorFullWidth="true"
                app:tabIndicatorGravity="stretch"
                app:tabMinWidth="0dp"
                app:tabMode="fixed"
                app:tabPaddingEnd="8dp"
                app:tabPaddingStart="8dp"
                app:tabRippleColor="@android:color/transparent"
                app:tabSelectedTextColor="?attr/colorOnPrimary"
                app:tabTextAppearance="@style/TextAppearance.Auxio.LabelLarger"
                app:tabTextColor="?attr/colorOnSurfaceVariant" />

        </org.bumbumapps.musicplayer.ui.EdgeAppBarLayout>

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/home_pager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior"
            tools:layout="@layout/fragment_home_list" />

        <!-- Kept for the shuffle invariant in PlaybackStateManager; the hero tile is the visible entry point. -->
        <org.bumbumapps.musicplayer.home.FloatingActionButtonContainer
            android:id="@+id/home_fab_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_anchor="@id/home_pager"
            app:layout_anchorGravity="bottom|end">

            <org.bumbumapps.musicplayer.home.AdaptiveFloatingActionButton
                android:id="@+id/home_fab"
                style="@style/Widget.Material3.FloatingActionButton.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/spacing_medium"
                android:contentDescription="@string/desc_shuffle_all"
                android:src="@drawable/ic_shuffle"
                app:backgroundTint="?attr/colorPrimary"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Auxio.FloatingActionButton.PlayPause"
                app:tint="?attr/colorOnPrimary" />

        </org.bumbumapps.musicplayer.home.FloatingActionButtonContainer>

    </org.bumbumapps.musicplayer.ui.EdgeCoordinatorLayout>
</layout>
