<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".playback.PlaybackFragment">

    <data>

        <variable
            name="song"
            type="org.bumbumapps.musicplayer.music.Song" />

        <variable
            name="playbackModel"
            type="org.bumbumapps.musicplayer.playback.PlaybackViewModel" />

        <variable
            name="detailModel"
            type="org.bumbumapps.musicplayer.detail.DetailViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/playback_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false">

        <!-- Blurred cover backdrop (blur is applied in code on Android 12+) -->
        <ImageView
            android:id="@+id/playback_backdrop"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:alpha="0.55"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            app:albumArt="@{song}"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/playback_scrim"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/ui_playback_scrim"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/playback_toolbar"
            style="@style/Widget.Auxio.Toolbar.Icon.Down"
            android:background="@android:color/transparent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:menu="@menu/menu_playback"
            app:title="@string/lbl_playback"
            app:titleCentered="true"
            app:titleTextAppearance="@style/TextAppearance.Auxio.Eyebrow" />

        <androidx.cardview.widget.CardView
            android:id="@+id/playback_cover_card"
            style="@style/Widget.Auxio.Image.Full"
            android:layout_marginStart="28dp"
            android:layout_marginTop="@dimen/spacing_medium"
            android:layout_marginEnd="28dp"
            android:layout_marginBottom="28dp"
            app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
            app:cardCornerRadius="@dimen/radius_cover_large"
            app:cardElevation="18dp"
            app:layout_constrainedHeight="true"
            app:layout_constraintBottom_toTopOf="@+id/playback_song"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/playback_toolbar"
            app:layout_constraintVertical_bias="0.3">

            <ImageView
                android:id="@+id/playback_cover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@{@string/desc_album_cover(song.name)}"
                android:scaleType="centerCrop"
                app:albumArt="@{song}"
                tools:src="@drawable/ic_album" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/playback_song"
            style="@style/Widget.Auxio.TextView.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="28dp"
            android:layout_marginEnd="@dimen/spacing_small"
            android:onClick="@{() -> detailModel.navToItem(playbackModel.song)}"
            android:text="@{song.name}"
            android:textAppearance="@style/TextAppearance.Auxio.NowPlayingTitle"
            app:layout_constraintBottom_toTopOf="@+id/playback_artist"
            app:layout_constraintEnd_toStartOf="@+id/playback_share"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            tools:text="Song Name" />

        <ImageButton
            android:id="@+id/playback_share"
            style="@style/Widget.Auxio.Button.Unbounded"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="20dp"
            android:contentDescription="@string/lbl_share_song"
            android:src="@drawable/ic_share"
            app:layout_constraintBottom_toBottomOf="@+id/playback_artist"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/playback_song"
            app:tint="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/playback_artist"
            style="@style/Widget.Auxio.TextView.Secondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="28dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="@dimen/spacing_small"
            android:onClick="@{() -> detailModel.navToItem(playbackModel.song.album.artist)}"
            android:text="@{song.album.artist.resolvedName}"
            android:textAppearance="@style/TextAppearance.Auxio.TitleMedium"
            android:textColor="?attr/colorPrimary"
            app:layout_constraintBottom_toTopOf="@+id/playback_album"
            app:layout_constraintEnd_toStartOf="@+id/playback_share"
            app:layout_constraintStart_toStartOf="parent"
            tools:text="Artist Name" />

        <TextView
            android:id="@+id/playback_album"
            style="@style/Widget.Auxio.TextView.Secondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="28dp"
            android:layout_marginEnd="@dimen/spacing_small"
            android:layout_marginBottom="@dimen/spacing_medium"
            android:onClick="@{() -> detailModel.navToItem(playbackModel.song.album)}"
            android:text="@{song.album.name}"
            android:textAppearance="@style/TextAppearance.Auxio.BodyMedium"
            app:layout_constraintBottom_toTopOf="@+id/playback_seek_bar"
            app:layout_constraintEnd_toStartOf="@+id/playback_share"
            app:layout_constraintStart_toStartOf="parent"
            tools:text="Album Name" />

        <org.bumbumapps.musicplayer.playback.PlaybackSeekBar
            android:id="@+id/playback_seek_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toTopOf="@+id/playback_play_pause"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <ImageButton
            android:id="@+id/playback_loop"
            style="@style/Widget.Auxio.Button.Unbounded"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:contentDescription="@string/desc_change_loop"
            android:onClick="@{() -> playbackModel.incrementLoopStatus()}"
            android:src="@drawable/ic_loop"
            app:layout_constraintBottom_toBottomOf="@+id/playback_play_pause"
            app:layout_constraintEnd_toStartOf="@+id/playback_skip_prev"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/playback_play_pause" />

        <ImageButton
            android:id="@+id/playback_skip_prev"
            style="@style/Widget.Auxio.Button.Unbounded"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@string/desc_skip_prev"
            android:onClick="@{() -> playbackModel.skipPrev()}"
            android:padding="12dp"
            android:src="@drawable/ic_skip_prev"
            app:layout_constraintBottom_toBottomOf="@+id/playback_play_pause"
            app:layout_constraintEnd_toStartOf="@+id/playback_play_pause"
            app:layout_constraintStart_toEndOf="@+id/playback_loop"
            app:layout_constraintTop_toTopOf="@+id/playback_play_pause"
            app:tint="?attr/colorOnSurface" />

        <ImageButton
            android:id="@+id/playback_play_pause"
            android:layout_width="78dp"
            android:layout_height="78dp"
            android:layout_marginBottom="36dp"
            android:background="@drawable/ui_circle_primary"
            android:contentDescription="@string/desc_play_pause"
            android:elevation="10dp"
            android:padding="22dp"
            android:scaleType="fitCenter"
            android:src="@drawable/sel_playing_state"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/playback_skip_next"
            app:layout_constraintStart_toEndOf="@+id/playback_skip_prev"
            app:tint="@android:color/white"
            tools:src="@drawable/ic_play" />

        <ImageButton
            android:id="@+id/playback_skip_next"
            style="@style/Widget.Auxio.Button.Unbounded"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@string/desc_skip_next"
            android:onClick="@{() -> playbackModel.skipNext()}"
            android:padding="12dp"
            android:src="@drawable/ic_skip_next"
            app:layout_constraintBottom_toBottomOf="@+id/playback_play_pause"
            app:layout_constraintEnd_toStartOf="@+id/playback_shuffle"
            app:layout_constraintStart_toEndOf="@+id/playback_play_pause"
            app:layout_constraintTop_toTopOf="@+id/playback_play_pause"
            app:tint="?attr/colorOnSurface" />

        <ImageButton
            android:id="@+id/playback_shuffle"
            style="@style/Widget.Auxio.Button.Unbounded"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="20dp"
            android:contentDescription="@string/desc_shuffle"
            android:onClick="@{() -> playbackModel.invertShuffleStatus()}"
            android:src="@drawable/ic_shuffle"
            app:layout_constraintBottom_toBottomOf="@+id/playback_play_pause"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/playback_skip_next"
            app:layout_constraintTop_toTopOf="@+id/playback_play_pause"
            app:tint="@color/sel_accented" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
